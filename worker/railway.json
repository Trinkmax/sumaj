{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/worker/**",
      "!/worker/README.md",
      "!/worker/.env.example"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 20,
    "sleepApplication": false
  }
}
